{
	"name": "n8n-nodes-straitly",
	"version": "0.1.0",
	"description": "n8n community node for Straitly, the AI gateway: a chat model for the AI Agent plus a node (also usable as an agent tool) to call Claude, GPT, Gemini, DeepSeek and more, list models and prices, check balance, manage child keys and read request logs.",
	"license": "MIT",
	"homepage": "https://github.com/khmuhtadin/n8n-nodes-straitly#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"straitly",
		"ai-gateway",
		"llm",
		"openai-compatible",
		"claude",
		"gpt",
		"gemini",
		"deepseek",
		"ai"
	],
	"author": {
		"name": "khmuhtadin",
		"email": "contact@khmuhtadin.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khmuhtadin/n8n-nodes-straitly.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test test/",
		"smoke": "npm run build && node scripts/smoke.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StraitlyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Straitly/Straitly.node.js",
			"dist/nodes/StraitlyChatModel/StraitlyChatModel.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"@n8n/ai-node-sdk": "*",
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/khmuhtadin/n8n-nodes-straitly/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	}
}
