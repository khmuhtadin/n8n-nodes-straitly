    {
      "name": "Plan Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$('Config').first().json;const rows=$input.all().map(i=>i.json);const h=Object.fromEntries((x.payload?.headers||[]).map(h=>[String(h.name).toLowerCase(),String(h.value)]));\nconst from=h.from||'';const address=(from.match(/<([^>]+)>/)?.[1]||from).trim().toLowerCase();\nfunction body(p){if(!p)return '';if(p.mimeType==='text/plain'&&p.body?.data)return Buffer.from(p.body.data,'base64').toString('utf8');return (p.parts||[]).map(body).filter(Boolean).join('\\n');}\nconst text=body(x.payload)||x.snippet||'';const id=String(x.id||'');if(id&&rows.some(r=>String(r.message_id)===id))return [];\nconst date=$now.setZone(x.timezone).toISODate();const invalid=!id||!x.threadId||!address.match(/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/)||!text.trim();\nconst auto=/no.?reply|mailer-daemon|newsletter/i.test(address)||h['list-id']||h['list-unsubscribe']||(/^(auto-generated|auto-replied)$/i.test(h['auto-submitted']||''))||address.split('@')[1]===x.teamDomain.toLowerCase();\nreturn [{json:{message_id:id||('invalid-'+$execution.id),thread_id:String(x.threadId||''),from:address,subject:h.subject||'',body:text.slice(0,x.maxBodyChars),received_at:new Date(Number(x.internalDate)||Date.now()).toISOString(),logged_at:$now.toISO(),day:date,category:'other',priority:'normal',confidence:0,language:'',summary:invalid?'Invalid input':auto?'Automated or internal email':'',draft_id:'',faq_rows:'',status:invalid?'invalid_input':auto?'skipped_sender':'processing',eligible:!invalid&&!auto,alert_low:!rows.some(r=>r.day===date&&String(r.status).startsWith('skipped_low_balance'))}}];"
      },
      "position": [
        1032,
        0
      ],
      "id": "d587cb75-e218-4877-ace0-0e6f2a802615"
    },
