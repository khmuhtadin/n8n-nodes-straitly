      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Config').first().json,day=$now.setZone(c.timezone).minus({days:1}).toISODate();const rows=$('Read Digest Ledger').all().map(i=>i.json).filter(r=>r.message_id);const yesterday=rows.filter(r=>r.day===day);const counts={};for(const r of yesterday){const key=r.category+' / '+r.status;counts[key]=(counts[key]||0)+1;}const sent=$input.all().map(i=>i.json);const pending=rows.filter(r=>r.priority==='urgent'&&!sent.some(m=>m.threadId===r.thread_id&&Number(m.internalDate)>Date.parse(r.received_at)));const list=pending.slice(0,c.digestMaxUrgent).map(r=>r.summary+' | https://mail.google.com/mail/u/0/#all/'+r.thread_id);return [{json:{text:'Support digest '+day+'\\n'+(yesterday.length?Object.entries(counts).map(([k,v])=>k+': '+v).join('\\n'):'No emails logged yesterday.')+'\\nUrgent threads without a later sent message: '+pending.length+'\\n'+(list.join('\\n')||'None.')+(pending.length>c.digestMaxUrgent?'\\nList truncated; check Log for the rest.':'')}}];"
