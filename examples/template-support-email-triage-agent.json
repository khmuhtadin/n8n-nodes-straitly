        "jsCode": "const p=$('Plan Intake').item.json,c=$('Config').first().json;let a=$json.output;try{if(typeof a==='string')a=JSON.parse(a);}catch{a=null;}const valid=!!a&&typeof a==='object'&&['billing','bug','how-to','sales','other'].includes(a.category)&&['low','normal','urgent'].includes(a.priority)&&typeof a.confidence==='number'&&Number.isFinite(a.confidence)&&a.confidence>=0&&a.confidence<=1&&typeof a.language==='string'&&typeof a.summary==='string'&&typeof a.draft_reply==='string'&&Array.isArray(a.faq_rows)&&a.faq_rows.every(v=>typeof v==='string');\n// Verify cited IDs against the actual tool observations, not just model claims.\nlet known=new Set();for(const s of ($json.intermediateSteps||[])){let o=s.observation;try{if(typeof o==='string')o=JSON.parse(o);}catch{o=[];}const rows=Array.isArray(o)?o:[o];for(const r of rows){const v=r?.json||r;if(v?.faq_id)known.add(String(v.faq_id));}}\nconst ids=valid?a.faq_rows.filter(id=>known.has(id)):[];const allowed=valid&&a.confidence>=c.minConfidence&&a.draft_reply.trim().length>0&&a.draft_reply.length<=c.maxReplyChars&&a.faq_rows.length===ids.length&&(a.category!=='how-to'||ids.length>0);\nreturn [{json:{...p,category:valid?a.category:'other',priority:valid?a.priority:'normal',language:valid?a.language:'',confidence:valid?a.confidence:0,summary:valid?a.summary.slice(0,800):'Agent or output validation failed',faq_rows:ids.join(', '),draft_reply:allowed?a.draft_reply:'',status:allowed?'ready':'needs_human',allowed,notify:!valid||(valid&&a.priority==='urgent')}}];"
