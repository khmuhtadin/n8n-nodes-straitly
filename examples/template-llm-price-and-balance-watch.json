    {
      "name": "Pack Current",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const data=$input.all().map(x=>x.json);const catalog=data.map(x=>({id:x.id,input:x.input_price_usd_per_million,output:x.output_price_usd_per_million}));if(!catalog.length||catalog.some(x=>!x.id||typeof x.input!=='number'||typeof x.output!=='number'||x.input<0||x.output<0)||new Set(catalog.map(x=>x.id)).size!==catalog.length)throw new Error('Catalog is empty or contains invalid prices; snapshot preserved');catalog.sort((a,b)=>a.id.localeCompare(b.id));return [{json:{scope:'catalog',catalog}}];"
      },
      "onError": "continueErrorOutput",
      "position": [
        688,
        752
