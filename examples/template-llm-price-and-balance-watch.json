      "name": "Pack Previous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.model_id&&x.status==='active');const catalog=rows.map(x=>({id:x.model_id,input:Number(x.input_price),output:Number(x.output_price)})).sort((a,b)=>a.id.localeCompare(b.id));return [{json:{scope:'catalog',catalog}}];"
