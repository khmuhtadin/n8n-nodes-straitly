    {
      "name": "Build Balance Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json,now=$now.toISO(),day=$now.setZone(cfg.timezone).toFormat('yyyy-MM-dd'),hour=$now.setZone(cfg.timezone).toFormat('yyyy-MM-dd-HH');const b=$input.first().json;const logs=$('Read Journal').all().map(x=>x.json);if(b.currency!=='USD'||b.has_wallet!==true||typeof b.available_usd!=='number'||b.available_usd<0)throw new Error('Invalid USD balance response');const balance=b.available_usd;const prev=logs.filter(x=>x.kind==='balance'&&typeof x.balance_usd==='number'&&Date.parse(x.observed_at)<Date.parse(now)).sort((a,b)=>Date.parse(b.observed_at)-Date.parse(a.observed_at))[0];const elapsed=prev?(Date.parse(now)-Date.parse(prev.observed_at))/3600000:0;const burn=prev&&elapsed>0&&balance<prev.balance_usd?(prev.balance_usd-balance)/elapsed:null;const hours=burn>0?balance/burn:null;const sent=new Set(logs.filter(x=>x.status==='sent'&&x.kind==='balance'&&x.key.startsWith('balance:'+day)).flatMap(x=>(x.alert_types||'').split(',')));let types=[];if(balance<Number(cfg.lowBalanceUsd)&&!sent.has('low'))types.push('low');if(hours!==null&&hours<Number(cfg.runwayHours)&&!sent.has('runway'))types.push('runway');const key='balance:'+hour,prior=logs.find(x=>x.key===key);let text='Balance $'+balance.toFixed(4)+(hours===null?'; runway unavailable (no positive burn sample).':'; estimated runway '+hours.toFixed(1)+' hours.');if(prior&&['queued','delivery_failed'].includes(prior.status)){types=(prior.alert_types||'').split(',').filter(x=>x&&!sent.has(x));text=prior.text;}return [{json:{key,kind:'balance',status:types.length?'queued':prior?.status==='sent'?'sent':'quiet',observed_at:now,balance_usd:balance,burn_usd_per_hour:burn,hours_left:hours,text,alert_types:[...new Set([...(prior?.status==='sent'?(prior.alert_types||'').split(','):[]),...types])].filter(Boolean).join(','),payload:JSON.stringify({notify:types.length>0,needsLlm:false})}}];"
      },
      "onError": "continueErrorOutput",
      "position": [
        1704,
        752
      ],
      "id": "2af822b0-f3a1-46f0-b996-81a330554839"
    },
