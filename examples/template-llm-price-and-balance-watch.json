    {
      "name": "Build Catalog Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cfg=$('Config').first().json,now=$now.toISO(),day=$now.setZone(cfg.timezone).toFormat('yyyy-MM-dd');const old=$('Pack Previous').first().json.catalog,cur=$('Pack Current').first().json.catalog,logs=$('Read Journal').all().map(x=>x.json);const key='catalog:'+day,prior=logs.find(x=>x.key===key);const changes=[];const before=new Map(old.map(x=>[x.id,x])),after=new Map(cur.map(x=>[x.id,x]));if(old.length){for(const x of cur){const p=before.get(x.id);if(!p){changes.push('New '+x.id);continue;}for(const k of ['input','output']){const a=p[k],b=x[k];if(a!==b&&(a===0||Math.abs((b-a)/a)*100>=Number(cfg.priceThresholdPct)))changes.push(x.id+' '+k+': $'+a+' -> $'+b+' per million');}}for(const x of old)if(!after.has(x.id))changes.push('Removed '+x.id);}const rows=cur.map(x=>({model_id:x.id,input_price:x.input,output_price:x.output,status:'active',observed_at:now}));for(const x of old)if(!after.has(x.id))rows.push({model_id:x.id,input_price:x.input,output_price:x.output,status:'removed',observed_at:now});const base=!old.length;let text=base?'Baseline saved for '+cur.length+' models.':changes.length+' catalog changes.\\n'+changes.slice(0,Number(cfg.digestLimit)).join('\\n');let status=base||changes.length?'queued':'no_change',notify=base||changes.length>0,needsLlm=!base&&changes.length>0;if(prior&&['sent','no_change'].includes(prior.status)){status=prior.status;notify=false;needsLlm=false;}else if(prior&&['queued','delivery_failed'].includes(prior.status)){text=prior.text;notify=true;needsLlm=false;status='queued';}return [{json:{key,kind:'catalog',status,observed_at:now,balance_usd:null,burn_usd_per_hour:null,hours_left:null,text,alert_types:'',payload:JSON.stringify({rows,changes,notify,needsLlm})}}];"
      },
      "position": [
        1136,
        752
      ],
      "id": "d1314e10-2269-4a1e-99c8-11bc18140cbe"
    },
    {
      "name": "Check Balance",
      "type": "n8n-nodes-straitly.straitly",
      "typeVersion": 1,
      "parameters": {
        "resource": "account",
        "operation": "getBalance"
      },
      "onError": "continueErrorOutput",
