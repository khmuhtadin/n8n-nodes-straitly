      "position": [
        -80,
        -30
      ]
    },
    {
      "parameters": {
        "content": "### List models",
        "width": 235,
        "height": 210,
        "color": 7
      },
      "id": "models-area",
      "name": "Models area",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        -30
      ]
    },
    {
      "parameters": {
        "content": "### Pick the cheapest listed input price",
        "width": 320,
        "height": 210,
        "color": 7
      },
      "id": "selection-area",
