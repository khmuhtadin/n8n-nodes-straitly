        0,
        40
      ]
    },
    {
      "parameters": {
        "resource": "model",
        "operation": "getMany",
        "returnAll": true,
        "simplify": true,
        "filters": {
          "vision": true
        }
      },
      "id": "get-models",
      "name": "Get Models",
      "type": "n8n-nodes-straitly.straitly",
      "typeVersion": 1,
      "position": [
